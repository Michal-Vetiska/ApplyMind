# ApplyMind environment configuration
# Copy to .env and fill in secrets. Never commit .env.

# Application
APP_NAME=ApplyMind
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
SECRET_ENCRYPTION_KEY=change-me-fernet-key-base64-32bytes==
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Single-user auth (seeded on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME="ApplyMind Owner"

# Database
DATABASE_URL=postgresql+asyncpg://applymind:applymind@localhost:5432/applymind
DATABASE_URL_SYNC=postgresql://applymind:applymind@localhost:5432/applymind

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File storage
DATA_DIR=./data
UPLOAD_MAX_MB=10

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMS=1536
LLM_MONTHLY_BUDGET_USD=20
LLM_ENABLED=true

# Email sending
EMAIL_DRY_RUN=true
EMAIL_SENDING_ENABLED=false
DAILY_SEND_LIMIT=10

# Session
SESSION_COOKIE_NAME=applymind_session
SESSION_MAX_AGE_HOURS=168

# Frontend
VITE_API_BASE_URL=http://localhost:8000
